# ===== Database =====
# Dev/MVP: để trống DATABASE_URL -> mặc định dùng SQLite tại gốc project
# (seacorp_asset_dev.db), không cần cài đặt gì thêm, phù hợp máy không có
# Docker/Postgres. Khi triển khai thật, bỏ comment dòng Postgres dưới và
# chạy qua docker-compose.
# DATABASE_URL=postgresql+psycopg://seacorp_asset_app:<password>@localhost:5432/seacorp_asset?sslmode=prefer
DB_SCHEMA=seacorp_asset

# ===== AI (Claude API) =====
# Để trống => hệ thống fallback sang nhập liệu/phân loại thủ công, không tự suy diễn.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ===== Auth =====
# Đổi giá trị này khi triển khai thật — không dùng giá trị mẫu trong môi trường sản xuất.
SECRET_KEY=change-me-dev-only-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ===== Intake provider (Giai đoạn 1 mặc định: manual_intake) =====
INTAKE_PROVIDER=manual_intake

# ===== Email/Teams Giai đoạn 2 (chưa cấu hình trong MVP) =====
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
GMAIL_CREDENTIALS_JSON=
TEAMS_WEBHOOK_URL=

# ===== Vận hành =====
APP_ENV=development
LOG_LEVEL=INFO
